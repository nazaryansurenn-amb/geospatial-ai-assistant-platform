# Copy to .env. Needed only for the AI assistants; the map and analytics work without it.

# Map assistant (OpenAI function calling)
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_COPILOT_MODEL=gpt-5.4-mini
# The assistant stays off unless this line reads exactly OPENAI_AGENT_ENABLED=true
OPENAI_AGENT_ENABLED=false

# Irrigation Assistant (Claude Agent SDK). Live mode also needs an approved payload
# (scripts/canal_ops_payload_review.py); without it the fixture mode runs with no model call.
ANTHROPIC_API_KEY=your_anthropic_api_key_here
LIVE_ENABLED=0

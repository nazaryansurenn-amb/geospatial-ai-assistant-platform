{
 "version": "canal_ops_map_layers_v2",
 "frozen": "2026-11-02, from the owner-approved terrain rebuild design section 5 (colour-blind safe canal colours) and the owner's notes of the same day (canals on borders and roads; one pump station per lifted cluster). Change only as a new version.",
 "purpose": "Map layers for the map-centred Irrigation Assistant page (8554, internal): satellite basemap, cadastral parcels coloured by land types v1.5, community outlines, the outline of the 44 communities, the Lower Hrazdan observed zone, the real main canal and the synthetic terrain-routed network v3 with pumping areas.",
 "inputs": {
  "cadastre": "data/source/cadastre/parcels_wua.gpkg",
  "parcel_ids": "data/analysis/parcel_eo/current_halo_v1/current_parcels.parquet",
  "land_types": "server_data/review/alphaearth_photo_review_20261030_v1/releases/landtypes_v1_5/parcels.parquet",
  "communities": "data/source/wua_areas.geojson",
  "canal": "data/source/lower_hrazdan.geojson",
  "network_nodes": "data/analysis/canal_ops_sim_v1/network_v3/nodes.parquet",
  "network_edges": "data/analysis/canal_ops_sim_v1/network_v3/edges.parquet",
  "network_parcels": "data/analysis/canal_ops_sim_v1/network_v3/parcel_node.parquet",
  "network_summary": "data/analysis/canal_ops_sim_v1/network_v3/summary.json",
  "not_used": "SQL archive and every archive-derived layer: owner decision 2 of plan v6, not read at all"
 },
 "crs_metric": "EPSG:32638",
 "parcels": {
  "simplify_deg": 2.5e-06,
  "simplify_note": "about 0.25 m, as the 8548 land-type map; hectares shown are the official ones",
  "codes": "cadastral codes are used only to join geometry to parcel ids and are never written to a layer",
  "fill_opacity": 0.3,
  "fill_opacity_note": "parcel fills at 30 % so the canals stay readable (design section 5)"
 },
 "wua_outline": {
  "label": "Outline of the 44 communities",
  "close_m": 20.0,
  "fill_holes_below_ha": 10.0,
  "rule": "union of the 44 community outlines; slivers closed by a 20 m mitred closing; interior holes under 10 ha filled; larger holes kept and explained"
 },
 "observed_zone": {
  "label": "Lower Hrazdan observed zone, stages I and II",
  "buffer_m": 30.0,
  "close_m": 200.0,
  "simplify_m": 5.0,
  "rule": "union of the 22,802 observed-zone parcel outlines, closed by 200 m (gaps of roads and ditches between fields; buffer out, then in), buffered 30 m outward and simplified to 5 m; area reported. A 60 m closing left 251 separate pieces and an 18 MB outline in the first build."
 },
 "terrain_areas": {
  "dissolve_out_m": 15.0,
  "dissolve_in_m": 10.0,
  "simplify_m": 2.0
 },
 "basemap": {
  "id": "satellite",
  "type": "raster",
  "tiles": [
   "https://server.arcgisonline.com/ArcGIS/rest/services/World_Imagery/MapServer/tile/{z}/{y}/{x}"
  ],
  "tile_size": 256,
  "max_zoom": 19,
  "attribution": "Imagery © Esri, Maxar, Earthstar Geographics"
 },
